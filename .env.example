# Copy this file to .env and fill in your values.
# The .env file is ignored by git and never sent to the client in API responses.
# It is only used server-side to pre-fill settings fields.

# macOS/Linux only: sudo password for running privileged Wi-Fi commands
SUDOER_PASSWORD=your_sudo_password_here

# iperf3 server address (optional). If not set, "localhost" is used.
# Use the address of another computer running "iperf3 -s" to enable throughput tests.
IPERF_SERVER_ADRS=192.168.1.10
